!                       -*-f90-*-    (for Emacs)
!  cparam.local
!
!  Local settings concerning grid size and number of CPUs.
!  This file is included by cparam.f90
!
integer, parameter :: ncpus=8,nprocy=2,nprocx=4,nprocz=ncpus/(nprocx*nprocy)
integer, parameter :: nxgrid=4096,nygrid=nxgrid,nzgrid=1
